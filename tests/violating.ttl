# Instance data with twelve planted defects, each of which MUST be reported.
# tests/validate.py asserts on the expected violation set, so this doubles as
# documentation of what the shapes actually catch.
#
# sagebrain:de_associated_with used to union both its domain and range at once,
# which let OWL alone accept a combination the model never intended -- Sample
# de_associated_with DiseaseStage -- with only sh:class in SHACL to reject it.
# It was split into de_associated_with (Sample -> Pathway) and
# de_associated_with_stage (Pathway -> DiseaseStage) specifically to remove
# that gap (see ontology/main/sagebrain.ttl), so defects (a) and (i) below are
# now ordinary wrong-target-class violations like (c), not a demonstration of
# OWL/SHACL disagreement.

@prefix sagebrain: <https://w3id.org/synapse/sagebrain#> .
@prefix biolink:   <https://w3id.org/biolink/vocab/> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <https://example.org/sagebrain-test/> .

# (a) wrong target class -- de_associated_with must reach a Pathway, not a
#     DiseaseStage.
ex:samp1
    a biolink:MaterialSample ;
    sagebrain:de_associated_with ex:braakStage3 .

# (b) forward cardinality -- tests is many:1, so one trial, one compound.
ex:trial1
    a biolink:ClinicalTrial ;
    sagebrain:tests ex:donanemab , ex:lecanemab .

# (c) wrong target class -- has_diagnosis requires a DiseaseLabel.
#     NOTE: this is the defect that RDFS entailment suppresses. See the
#     VALIDATION CONFIGURATION section of sagebrain-shapes.ttl.
ex:ind1
    a sagebrain:Individual ;
    sagebrain:has_diagnosis ex:apoptosisPathway .

# (d) disjointness -- Case and Control are owl:disjointWith.
ex:ind2
    a sagebrain:Case , sagebrain:Control .

# (e) active inverse cardinality -- a Sample belongs to at most one Individual.
ex:ind3
    a sagebrain:Individual ;
    sagebrain:has_sample ex:samp9 .

ex:ind4
    a sagebrain:Individual ;
    sagebrain:has_sample ex:samp9 .

ex:samp9 a biolink:MaterialSample .

# (f) node kind -- edge targets must be IRIs, not literals.
ex:apoe
    a biolink:Gene ;
    sagebrain:participates_in "KEGG:hsa04010" .

# (g) wrong target class -- QCResultAssociation.qc_status must be a QCStatus.
ex:qcResult1
    a sagebrain:QCResultAssociation ;
    biolink:subject sagebrain:PhredScore ;
    biolink:object ex:samp1 ;
    sagebrain:qc_status ex:apoptosisPathway .

# (h) wrong target class -- derived_from_organ must reach an Organ or
#     OrganSubregion, not a Tissue.
ex:samp1 sagebrain:derived_from_organ ex:cortexTissue .

# (i) wrong target class -- de_associated_with_stage must reach a DiseaseStage,
#     not a Drug.
ex:apoptosisPathway sagebrain:de_associated_with_stage ex:donanemab .

# (j) wrong target class -- de_associated_with_disease must reach a
#     DiseaseLabel, not a Drug.
ex:synapticPathway
    a biolink:Pathway ;
    sagebrain:de_associated_with_disease ex:lecanemab .

# (k) wrong target class -- expression_classifier must reach an
#     ExpressionDirection, not a Drug.
ex:geneExprAssoc1
    a sagebrain:GeneExpressionAssociation ;
    biolink:subject ex:apoe ;
    biolink:object ex:samp1 ;
    sagebrain:weight "1.0"^^xsd:decimal ;
    sagebrain:expression_classifier ex:donanemab .

# (l) wrong target class -- derived_from must reach a MaterialSample or a
#     SynapseEntity, not a Gene.
ex:samp1 sagebrain:derived_from ex:apoe .

###  Supporting well-formed nodes  ##############################

ex:braakStage3      a sagebrain:DiseaseStage .
ex:donanemab        a biolink:Drug .
ex:lecanemab        a biolink:Drug .
ex:apoptosisPathway a biolink:Pathway .
ex:cortexTissue     a sagebrain:Tissue .

# Restated for the same reason examples/AD-cohort.ttl restates SageBrain-minted
# terms it references: pySHACL's sh:class only sees rdf:type triples present in
# the graph actually being validated, not ones that live solely in ont_graph.
sagebrain:PhredScore a sagebrain:QCMetric .
