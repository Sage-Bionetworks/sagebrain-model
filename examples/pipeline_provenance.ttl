# The reprocessing-pipeline provenance layer (imported from governanceDUO as
# ontology/imports/governance_layer.ttl, only built/checked under
# `make WITH_GOVERNANCE=1` -- see plans/governance_layer_import.md), made
# concrete: a two-step run
# producing the exact file `association:apoe-expr-samp01` (examples/AD-cohort.ttl)
# already names via `sagebrain:derived_from` -- `syn:syn26999999` below is the
# same node, not a lookalike, so this is the detailed path behind that
# association's plain provenance edge, not a disconnected demonstration.
#
# raw FASTQ dataset -(nf-core/rnaseq v3.11.1)-> gene-count matrix
#                    -(DESeq2 v1.34.0)-> syn:syn26999999 (the DE result file)
#
# syn:syn27000001/syn:syn27000002 are fictional but well-formed `syn\d+` ids,
# the same honest-fiction treatment `syn:syn26999999` itself gets in
# examples/AD-cohort.ttl -- there is no real Synapse project behind this
# example, but a real id would resolve to the identical node in both graphs.
#
# Activities are minted as gov:activity-<id>, governanceDUO's instance-IRI
# policy for graph nodes (gov:AR-42, gov:principal-<n>, ...); a URL Usage is
# named with gov:name, the governance graph's name predicate.
#
# Validated on its own (tests/validate.py check 8, WITH_GOVERNANCE=1 only),
# not merged with AD-cohort.ttl -- the shared syn:syn26999999 IRI is what
# connects the two, not a shared graph.

@prefix gov:  <https://sagebionetworks.org/governance/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix syn:  <https://www.synapse.org/Synapse:> .

syn:syn27000001 a gov:SynapseEntity .   # raw FASTQ dataset
syn:syn27000002 a gov:SynapseEntity .   # gene-count matrix (intermediate output)
syn:syn26999999 a gov:SynapseEntity .   # DE result -- same node apoe-expr-samp01.derived_from names

# raw FASTQ dataset -(nf-core/rnaseq v3.11.1)-> gene-count matrix
gov:activity-reprocess01
    a prov:Activity ;
    prov:qualifiedUsage
        [ a prov:Usage ;
          prov:entity syn:syn27000001 ;
          gov:wasExecuted false ] ,
        [ a prov:Usage ;
          gov:url "https://nf-co.re/rnaseq/3.11.1" ;
          gov:name "nf-core/rnaseq v3.11.1" ;
          gov:wasExecuted true ] ;
    prov:generated syn:syn27000002 .

# gene-count matrix -(DESeq2 v1.34.0)-> DE result
gov:activity-reprocess02
    a prov:Activity ;
    prov:qualifiedUsage
        [ a prov:Usage ;
          prov:entity syn:syn27000002 ;
          gov:wasExecuted false ] ,
        [ a prov:Usage ;
          gov:url "https://bioconductor.org/packages/release/bioc/html/DESeq2.html" ;
          gov:name "DESeq2 v1.34.0" ;
          gov:wasExecuted true ] ;
    prov:generated syn:syn26999999 .
