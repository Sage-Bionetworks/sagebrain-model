__pycache__/
*.pyc

# Makefile build artifacts: the merged and pruned TTL plus the converted VOWL
# JSON. All reproducible from ontology/ with `make json`.
build/

# ROBOT is 78 MB and is a published release artifact, so should not be committed:
# `make tools` sets it up along with owl2vowl.jar. OWL2VOWL has no upstream release
# asset for 0.3.7, so it is fetched from a mirror on Sage-WebVOWL and checksummed --
# see the OWL2VOWL_URL comment in the Makefile for why that is necessary.
tools/robot.jar
tools/owl2vowl.jar

# Scratch directory
tmp/

# Working data for the kg/ ingests -- downloads, generated Turtle, triple
# stores. Reproducible from the pipelines plus the committed manifests
# (see kg/README.md).
/data/

# QLever demo build context: load_qlever.py stages one release's ttl/*.ttl
# here before `docker build`. Regenerated on every run.
kg/reactome/qlever/data/

# Explorer: npm deps and the production bundle. Both reproducible with
# `npm install` / `npm run build` in explorer/ (or `make explore`).
explorer/node_modules/
explorer/dist/
