@prefix sagebrain: <https://w3id.org/synapse/sagebrain#> .
@prefix biolink:   <https://w3id.org/biolink/vocab/> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix vann:      <http://purl.org/vocab/vann/> .

#################################################################
#    Ontology
#################################################################

<https://w3id.org/synapse/sagebrain>
    a owl:Ontology ;
    dcterms:title "SageBrain Graph Model" ;
    rdfs:comment """Schema for the SageBrain knowledge graph: the common nodes and
connections used to integrate biological, clinical, systems-biology and
translational data across Synapse portals.

One layer: a T-Box of OWL classes and object properties, for RDF/OWL consumers.

Many elements are reused from the Biolink Model rather than minted here, e.g. 
biolink:Gene and biolink:Pathway, while sagebrain:participates_in is declared a
subproperty of biolink:participates_in. See the "Reused terms" section below. The
Biolink declarations are not in this file: they come from
ontology/imports/biolink.ttl, which the build merges alongside it.

If you are validating instance data against ontology/shacl/sagebrain-shapes.ttl,
load this file as the ont_graph and do NOT run RDFS or OWL entailment over the
data graph: rdfs:range on a shared property here states a union of every pairing
that property is used in, so an inferencer will derive exactly the type an
sh:class constraint is testing for and pass every range violation vacuously. See
the VALIDATION CONFIGURATION section at the top of sagebrain-shapes.ttl.""" ;
    owl:versionIRI <https://w3id.org/synapse/sagebrain/0.3.0> ;
    owl:versionInfo "v0.3" ;
    vann:preferredNamespacePrefix "sagebrain" ;
    vann:preferredNamespaceUri "https://w3id.org/synapse/sagebrain#" ;
    dcterms:publisher <https://sagebionetworks.org> ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:source <https://docs.google.com/spreadsheets/d/1VCVPoEC7UZYgPmJCukCONMGVKq8xpRdcYKFlHIsMtLQ> ;
    rdfs:seeAlso <https://github.com/Sage-Bionetworks/sagebrain-model> ,
                 <https://w3id.org/synapse/sagebrain/shapes> ,
                 <https://biolink.github.io/biolink-model/> .

#################################################################
#    Annotation properties (model metadata carried from the source sheet)
#################################################################

sagebrain:elementCategory
    a owl:AnnotationProperty ;
    rdfs:label "element category" ;
    rdfs:comment "The broad category an element type belongs to, from the source model's \"Type\" column." ;
    rdfs:range sagebrain:ElementCategory .


sagebrain:weighted
    a owl:AnnotationProperty ;
    rdfs:label "weighted" ;
    rdfs:comment "True if the connection carries a numeric edge weight; false if it encodes presence/absence only." ;
    rdfs:range xsd:boolean .

sagebrain:optional
    a owl:AnnotationProperty ;
    rdfs:label "optional" ;
    rdfs:comment "True if the source model marks this connection as optional in the graph build." ;
    rdfs:range xsd:boolean .

sagebrain:nodeLevel
    a owl:AnnotationProperty ;
    rdfs:label "node level" ;
    rdfs:comment """Whether instances of this element class are one-per-real-world-particular
(Instance: a specific participant, sample, or clinical trial) or a node shared by reference
across many instances (Vocabulary: a disease label, a gene, a tissue type, a disease-specific
classification). Recorded because it is the fact every deactivated inverse-cardinality shape in
sagebrain-shapes.ttl turns on: an inverse maxCount of 1 is only ever safe to assert toward a
Vocabulary-level target when the relationship is itself a genuine one-parent hierarchy (as with
has_subregion), and is otherwise the exact shape of the mistake ISSUE-1 and ISSUE-3 documented.""" ;
    rdfs:range sagebrain:NodeLevel .


#################################################################
#    Node levels
#################################################################

sagebrain:NodeLevel
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Node Level" ;
    rdfs:comment "Whether an element class's instances are instance-level particulars or shared vocabulary-level nodes." .

sagebrain:NodeLevelScheme
    a skos:ConceptScheme ;
    rdfs:label "SageBrain node levels" ;
    skos:hasTopConcept sagebrain:Instance , sagebrain:Vocabulary .

sagebrain:Instance
    a sagebrain:NodeLevel ;
    skos:prefLabel "Instance" ;
    skos:definition "One node per real-world particular thing -- a specific participant, sample, or clinical trial." ;
    skos:inScheme sagebrain:NodeLevelScheme .

sagebrain:Vocabulary
    a sagebrain:NodeLevel ;
    skos:prefLabel "Vocabulary" ;
    skos:definition "A node referenced by many instances rather than minted per real-world thing -- a disease label, a gene, a tissue type, a disease-specific classification." ;
    skos:inScheme sagebrain:NodeLevelScheme .


#################################################################
#    Element categories
#################################################################

sagebrain:ElementCategory
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Element Category" ;
    rdfs:comment "A broad grouping of SageBrain element types." .

sagebrain:ElementCategoryScheme
    a skos:ConceptScheme ;
    rdfs:label "SageBrain element categories" ;
    skos:hasTopConcept sagebrain:Biological , sagebrain:Clinical ,
                       sagebrain:SystemsBiology , sagebrain:Translational .

sagebrain:Biological
    a sagebrain:ElementCategory ;
    skos:prefLabel "Biological" ;
    skos:inScheme sagebrain:ElementCategoryScheme .

sagebrain:Clinical
    a sagebrain:ElementCategory ;
    skos:prefLabel "Clinical" ;
    skos:inScheme sagebrain:ElementCategoryScheme .

sagebrain:SystemsBiology
    a sagebrain:ElementCategory ;
    skos:prefLabel "Systems Biology" ;
    skos:inScheme sagebrain:ElementCategoryScheme .

sagebrain:Translational
    a sagebrain:ElementCategory ;
    skos:prefLabel "Translational" ;
    skos:inScheme sagebrain:ElementCategoryScheme .

#################################################################
#    Reused terms (Biolink Model)
#
#    Some elements are not minted in the sagebrain namespace. The model uses
#    Biolink terms such as biolink:Gene and biolink:Pathway, so that a
#    SageBrain graph is Biolink data without a mapping step.
#
#    The description is attached with skos:scopeNote, NOT rdfs:comment. An
#    rdfs:comment on someone else's class reads as a definition of that class,
#    which is not ours to give.
#################################################################

biolink:Gene
    skos:scopeNote "A gene entity; source of expression data and drug target information." ;
    skos:editorialNote "Reused from the Biolink Model. Instances are expected to carry HGNC or Ensembl identifiers." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

biolink:Pathway
    skos:scopeNote "A biological pathway (e.g. Reactome, KEGG). Many genes per pathway; many pathways per gene." ;
    skos:editorialNote "Reused from the Biolink Model, which records it as an exact match for PW_0000001. Imported from external data source." ;
    sagebrain:elementCategory sagebrain:SystemsBiology ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

biolink:MaterialSample
    skos:scopeNote "A biological sample collected from a tissue. Could have multiple samples per individual." ;
    skos:editorialNote "Reused from the Biolink Model, which records it as an exact match for OBI_0000747." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Instance ;
    owl:versionInfo "v0.2" .

biolink:Disease
    skos:scopeNote "A disease label node. One node per disease (e.g. Alzheimer's Disease, ALS)." ;
    skos:editorialNote "Reused from the Biolink Model, which records it as an exact match for MONDO_0000001." ;
    sagebrain:elementCategory sagebrain:Clinical ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

biolink:Drug
    skos:scopeNote "An existing drug or compound with known gene targets." ;
    skos:editorialNote "Reused from the Biolink Model, which records it as an exact match for CHEBI_23888. Imported from external data source. Biolink places Drug under MolecularMixture, i.e. a formulated substance rather than a single compound -- if the data turns out to be single compounds, biolink:SmallMolecule or biolink:ChemicalEntity is the better term." ;
    sagebrain:elementCategory sagebrain:Translational ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

biolink:ClinicalTrial
    skos:scopeNote "A clinical trial entry. Presence/absence linked to disease and compound." ;
    skos:editorialNote "Reused from the Biolink Model, where it is a kind of Study, recorded as an exact match for NCIT_C71104." ;
    sagebrain:elementCategory sagebrain:Translational ;
    sagebrain:nodeLevel sagebrain:Instance ;
    owl:versionInfo "v0.2" .

#################################################################
#    Elements (classes)
#################################################################

###  Biological

sagebrain:Individual
    a owl:Class ;
    rdfs:label "Individual" ;
    rdfs:comment "A study participant (human or animal)." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Instance ;
    owl:versionInfo "v0.2" .

sagebrain:Organ
    a owl:Class ;
    rdfs:label "Organ" ;
    rdfs:comment "A biological organ. Contains one or more organ sub-regions." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

sagebrain:OrganSubregion
    a owl:Class ;
    rdfs:label "Organ Sub-Region" ;
    rdfs:comment "A distinct anatomical sub-region within an organ (e.g. hippocampus within brain). Separate from tissue." ;
    skos:editorialNote "Component of Organ. Especially relevant for brain-related diseases such as AD and ALS." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

sagebrain:Tissue
    a owl:Class ;
    rdfs:label "Tissue" ;
    rdfs:comment "A tissue type collected from an organ or organ sub-region. Source of samples." ;
    skos:editorialNote "Tissue names are not standardized across diseases; this graph represents the schema concept only." ;
    sagebrain:elementCategory sagebrain:Biological ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

###  Clinical
#
#  DiseaseStatus (and sagebrain:has_status) was removed in v0.3. It had no
#  vocabulary anywhere -- not an ontology, not a column in the AD Knowledge
#  Portal model distinct from diagnosis -- and the AD model's nearest terms
#  (no cognitive impairment / MCI / dementia) are values of *diagnosis*, not a
#  separate axis. Decided redundant with sagebrain:has_diagnosis rather than
#  left open pending a vocabulary that direct evidence never supported.

sagebrain:Case
    a owl:Class ;
    rdfs:label "Case" ;
    rdfs:comment "An individual classified as a disease case." ;
    skos:editorialNote "Subtype of Individual for disease group assignment." ;
    rdfs:subClassOf sagebrain:Individual ;
    owl:disjointWith sagebrain:Control ;
    sagebrain:elementCategory sagebrain:Clinical ;
    sagebrain:nodeLevel sagebrain:Instance ;
    owl:versionInfo "v0.2" .

sagebrain:Control
    a owl:Class ;
    rdfs:label "Control" ;
    rdfs:comment "An individual classified as a healthy control." ;
    skos:editorialNote "Subtype of Individual for control group assignment." ;
    rdfs:subClassOf sagebrain:Individual ;
    sagebrain:elementCategory sagebrain:Clinical ;
    sagebrain:nodeLevel sagebrain:Instance ;
    owl:versionInfo "v0.2" .

sagebrain:Pathology
    a owl:Class ;
    rdfs:label "Pathology" ;
    rdfs:comment "A disease pathology classification node, associated with the sample." ;
    skos:editorialNote "Multiple nodes, disease-specific." ;
    sagebrain:elementCategory sagebrain:Clinical ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

sagebrain:DiseaseStage
    a owl:Class ;
    rdfs:label "Disease Stage" ;
    rdfs:comment "A disease progression stage associated with the Case." ;
    skos:editorialNote "Multiple nodes, disease-specific." ;
    sagebrain:elementCategory sagebrain:Clinical ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.2" .

###  Systems Biology
###  (Pathway is reused from Biolink -- see "Reused terms" above.)

sagebrain:Biodomain
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Biodomain" ;
    rdfs:comment "A higher-level biological domain grouping one or more pathways (e.g. neuroinflammation, synaptic)." ;
    sagebrain:elementCategory sagebrain:SystemsBiology ;
    sagebrain:nodeLevel sagebrain:Vocabulary ;
    owl:versionInfo "v0.3" .

#################################################################
#    Biodomains
#
#    Deliberately SageBrain-native (see sagebrain:belongs_to below): the AD
#    biodomain framework is not itself an ontology, so these 19 are minted
#    here as a SKOS vocabulary rather than left as an unmintable citation.
#
#    Names cross-checked against three independent sources rather than
#    recalled: Agora's own per-gene Biological Domains listing
#    (agora.adknowledgeportal.org), the body text of the open-access
#    methodology paper (Cary et al. 2024, PMC11033838, doi:10.1002/trc2.12461),
#    and the AD Knowledge Portal's "Biological Domain Classification Data and
#    Methods" help page. The authoritative enumeration lives in that paper's
#    supplementary table (and in the Synapse file syn51062522), both
#    access-gated -- check this list against either the next time someone on
#    the team has Synapse download permission for that entity.
#################################################################

sagebrain:BiodomainScheme
    a skos:ConceptScheme ;
    rdfs:label "AD biological domains" ;
    dcterms:source <https://doi.org/10.1002/trc2.12461> ;
    skos:hasTopConcept
        sagebrain:APPMetabolism , sagebrain:Apoptosis , sagebrain:Autophagy ,
        sagebrain:CellCycle , sagebrain:DNARepair , sagebrain:Endolysosome ,
        sagebrain:Epigenetic , sagebrain:ImmuneResponse , sagebrain:LipidMetabolism ,
        sagebrain:MetalBindingAndHomeostasis , sagebrain:MitochondrialMetabolism ,
        sagebrain:Myelination , sagebrain:OxidativeStress , sagebrain:Proteostasis ,
        sagebrain:RNASpliceosome , sagebrain:StructuralStabilization , sagebrain:Synapse ,
        sagebrain:TauHomeostasis , sagebrain:Vasculature .

sagebrain:APPMetabolism a sagebrain:Biodomain ; skos:prefLabel "APP Metabolism" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Apoptosis a sagebrain:Biodomain ; skos:prefLabel "Apoptosis" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Autophagy a sagebrain:Biodomain ; skos:prefLabel "Autophagy" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:CellCycle a sagebrain:Biodomain ; skos:prefLabel "Cell Cycle" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:DNARepair a sagebrain:Biodomain ; skos:prefLabel "DNA Repair" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Endolysosome a sagebrain:Biodomain ; skos:prefLabel "Endolysosome" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Epigenetic a sagebrain:Biodomain ; skos:prefLabel "Epigenetic" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:ImmuneResponse a sagebrain:Biodomain ; skos:prefLabel "Immune Response" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:LipidMetabolism a sagebrain:Biodomain ; skos:prefLabel "Lipid Metabolism" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:MetalBindingAndHomeostasis a sagebrain:Biodomain ; skos:prefLabel "Metal Binding and Homeostasis" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:MitochondrialMetabolism a sagebrain:Biodomain ; skos:prefLabel "Mitochondrial Metabolism" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Myelination a sagebrain:Biodomain ; skos:prefLabel "Myelination" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:OxidativeStress a sagebrain:Biodomain ; skos:prefLabel "Oxidative Stress" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Proteostasis a sagebrain:Biodomain ; skos:prefLabel "Proteostasis" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:RNASpliceosome a sagebrain:Biodomain ; skos:prefLabel "RNA Spliceosome" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:StructuralStabilization a sagebrain:Biodomain ; skos:prefLabel "Structural Stabilization" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Synapse a sagebrain:Biodomain ; skos:prefLabel "Synapse" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:TauHomeostasis a sagebrain:Biodomain ; skos:prefLabel "Tau Homeostasis" ; skos:inScheme sagebrain:BiodomainScheme .
sagebrain:Vasculature a sagebrain:Biodomain ; skos:prefLabel "Vasculature" ; skos:inScheme sagebrain:BiodomainScheme .

###  Translational

#################################################################
#    Connections (object properties)
#
#    Where a property is used on more than one (source, target) pair, its
#    rdfs:domain / rdfs:range is the union over those pairs. The union is
#    deliberately permissive -- it admits combinations the model does not, e.g.
#    Sample de_associated_with DiseaseStage -- so the permitted pairings are
#    stated per pair in the shapes graph, and only there.
#################################################################

sagebrain:tests
    a owl:ObjectProperty ;
    rdfs:label "tests" ;
    rdfs:domain biolink:ClinicalTrial ;
    rdfs:range biolink:Drug ;
    sagebrain:weighted false ;
    skos:editorialNote "Many trials per compound." ;
    owl:versionInfo "v0.2" .

sagebrain:has_trial
    a owl:ObjectProperty ;
    rdfs:label "has trial" ;
    rdfs:domain biolink:Disease ;
    rdfs:range biolink:ClinicalTrial ;
    sagebrain:weighted false ;
    owl:versionInfo "v0.2" .

#  sagebrain:relates_to was split in v0.3 into stage_of and pathology_of (see
#  ISSUE-2 in sagebrain-shapes.ttl for the contradiction this resolves): one
#  property recorded a many:1 cardinality for DiseaseStage/DiseaseStatus rows
#  and a 1:many cardinality for the Pathology row, which cannot both be true
#  of a single property's inverse. Splitting removes the conflict rather than
#  papering over it -- each sub-property now carries only the cardinality its
#  own row actually recorded. No status_of: DiseaseStatus was removed as
#  redundant with has_diagnosis (see the Clinical section above), so only two
#  of the three original readings survive.

sagebrain:stage_of
    a owl:ObjectProperty ;
    rdfs:label "stage of" ;
    rdfs:comment "Relates a disease-specific stage node to its disease label." ;
    rdfs:domain sagebrain:DiseaseStage ;
    rdfs:range biolink:Disease ;
    sagebrain:weighted false ;
    owl:versionInfo "v0.3" .

sagebrain:pathology_of
    a owl:ObjectProperty ;
    rdfs:label "pathology of" ;
    rdfs:comment "Relates a disease-specific pathology classification node to its disease label." ;
    rdfs:domain sagebrain:Pathology ;
    rdfs:range biolink:Disease ;
    sagebrain:weighted false ;
    skos:editorialNote "Disease-specific pathology classification." ;
    owl:versionInfo "v0.3" .

sagebrain:targets
    a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:domain biolink:Drug ;
    rdfs:range biolink:Gene ;
    sagebrain:weighted false ;
    skos:editorialNote "Imported from external data source. Drug compound targets a gene." ;
    owl:versionInfo "v0.2" .

sagebrain:used_to_treat
    a owl:ObjectProperty ;
    rdfs:label "used to treat" ;
    rdfs:subPropertyOf biolink:treats ;
    rdfs:domain biolink:Drug ;
    rdfs:range biolink:Disease ;
    skos:editorialNote "Narrows biolink:treats, which holds between any chemical, drug or treatment and any disease or phenotypic feature, to the model's Drug -> Disease edge." ;
    sagebrain:weighted false ;
    sagebrain:optional true ;
    skos:editorialNote "Optional." ;
    owl:versionInfo "v0.2" .

sagebrain:expressed_in
    a owl:ObjectProperty ;
    rdfs:label "expressed in" ;
    rdfs:domain biolink:Gene ;
    rdfs:range biolink:MaterialSample ;
    sagebrain:weighted true ;
    skos:editorialNote "Weight represents expression level relative to DE results." ;
    owl:versionInfo "v0.2" .

sagebrain:participates_in
    a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    rdfs:subPropertyOf biolink:participates_in ;
    rdfs:domain biolink:Gene ;
    rdfs:range biolink:Pathway ;
    skos:editorialNote "Narrows biolink:participates_in, which holds between any continuant and any process, to the model's Gene -> Pathway edge. Biolink records theirs as an exact match for RO_0000056." ;
    sagebrain:weighted false ;
    skos:editorialNote "v0.2 unweighted" ;
    owl:versionInfo "v0.2" .

sagebrain:has_sample
    a owl:ObjectProperty ;
    rdfs:label "has sample" ;
    rdfs:domain sagebrain:Individual ;
    rdfs:range biolink:MaterialSample ;
    sagebrain:weighted false ;
    skos:editorialNote "One individual contributes many samples." ;
    owl:versionInfo "v0.2" .

sagebrain:has_diagnosis
    a owl:ObjectProperty ;
    rdfs:label "has diagnosis" ;
    rdfs:domain sagebrain:Individual ;
    rdfs:range biolink:Disease ;
    sagebrain:weighted false ;
    skos:editorialNote "Disease diagnosis for an individual." ;
    owl:versionInfo "v0.2" .

sagebrain:staged_at
    a owl:ObjectProperty ;
    rdfs:label "staged at" ;
    rdfs:domain sagebrain:Individual ;
    rdfs:range sagebrain:DiseaseStage ;
    sagebrain:weighted false ;
    skos:editorialNote "Disease-specific staging or pathology classification." ;
    owl:versionInfo "v0.2" .

sagebrain:has_subregion
    a owl:ObjectProperty ;
    rdfs:label "has sub-region" ;
    rdfs:domain sagebrain:Organ ;
    rdfs:range sagebrain:OrganSubregion ;
    sagebrain:weighted false ;
    skos:editorialNote "Organ sub-region is a distinct anatomical component of the organ." ;
    owl:versionInfo "v0.2" .

sagebrain:contains_tissue
    a owl:ObjectProperty ;
    rdfs:label "contains tissue" ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( sagebrain:Organ sagebrain:OrganSubregion ) ] ;
    rdfs:range sagebrain:Tissue ;
    sagebrain:weighted false ;
    skos:editorialNote "An organ contains one or more tissue types." ;
    skos:editorialNote "A sub-region may also be the source of a tissue." ;
    owl:versionInfo "v0.2" .

sagebrain:belongs_to
    a owl:ObjectProperty ;
    rdfs:label "belongs to" ;
    rdfs:domain biolink:Pathway ;
    rdfs:range sagebrain:Biodomain ;
    rdfs:seeAlso <https://alz-journals.onlinelibrary.wiley.com/doi/10.1002/alz.078590> ;
    sagebrain:weighted false ;
    owl:versionInfo "v0.2" .

sagebrain:de_associated_with
    a owl:ObjectProperty ;
    rdfs:label "DE associated with" ;
    rdfs:comment "Links entities via a differential-expression association." ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( biolink:Pathway biolink:MaterialSample ) ] ;
    rdfs:range [ a owl:Class ;
                 owl:unionOf ( sagebrain:DiseaseStage biolink:Pathway ) ] ;
    sagebrain:weighted true ;
    sagebrain:optional true ;
    skos:editorialNote "Optional. DE state associated with pathway activity." ;
    skos:editorialNote "Optional. Differential expression result linking sample to pathway." ;
    owl:versionInfo "v0.3" .

#  Per-pair OWL restrictions, added in v0.3. rdfs:range above states only the
#  union over de_associated_with's two uses, which is what lets tests/violating.ttl's
#  defect (a) -- Sample de_associated_with DiseaseStage -- pass under RDFS/OWL
#  entailment even though sagebrain-shapes.ttl's sh:class rejects it per source
#  class. These restrictions state the real, narrower truth per source class, so a
#  reasoner's entailment stops disagreeing with the shapes graph. They do not
#  replace the shapes graph: an open-world owl:allValuesFrom still cannot *cap* an
#  edge the way sh:class does under closed-world validation, so
#  sagebrain-shapes.ttl remains the actual enforcement layer. See the VALIDATION
#  CONFIGURATION section of sagebrain-shapes.ttl for why the two layers coexist
#  and must be run without entailment.
biolink:MaterialSample
    rdfs:subClassOf [ a owl:Restriction ;
                       owl:onProperty sagebrain:de_associated_with ;
                       owl:allValuesFrom biolink:Pathway ] .

biolink:Pathway
    rdfs:subClassOf [ a owl:Restriction ;
                       owl:onProperty sagebrain:de_associated_with ;
                       owl:allValuesFrom sagebrain:DiseaseStage ] .

sagebrain:related_pathway
    a owl:ObjectProperty ;
    rdfs:label "related pathway" ;
    rdfs:domain biolink:Pathway ;
    rdfs:range biolink:Pathway ;
    sagebrain:weighted false ;
    sagebrain:optional true ;
    skos:editorialNote "Optional. Cross-pathway relationships for graph inference. Imported from external sources." ;
    owl:versionInfo "v0.2" .

sagebrain:associated_with
    a owl:ObjectProperty ;
    rdfs:label "associated with" ;
    rdfs:domain biolink:Pathway ;
    rdfs:range biolink:Disease ;
    sagebrain:weighted true ;
    sagebrain:optional true ;
    skos:editorialNote "Optional. Pathway associated with Disease Labels." ;
    owl:versionInfo "v0.2" .

sagebrain:source_tissue
    a owl:ObjectProperty ;
    rdfs:label "source tissue" ;
    rdfs:domain biolink:MaterialSample ;
    rdfs:range sagebrain:Tissue ;
    sagebrain:weighted false ;
    owl:versionInfo "v0.2" .

sagebrain:has_pathology
    a owl:ObjectProperty ;
    rdfs:label "has pathology" ;
    rdfs:domain biolink:MaterialSample ;
    rdfs:range sagebrain:Pathology ;
    sagebrain:weighted false ;
    skos:editorialNote "Pathology identifier for the sample." ;
    owl:versionInfo "v0.2" .

#################################################################
#    Associations (reified weighted connections)
#
#    Four of the plain connections above are marked sagebrain:weighted true:
#    expressed_in, de_associated_with (two source/target pairs), and
#    associated_with. A weight is a property OF an edge, which a plain RDF
#    triple cannot carry, and sagebrain-shapes.ttl's old #4 section left this
#    unconstrained rather than choosing between reification, RDF-star, or
#    dropping the number.
#
#    Resolved in v0.3 by reifying via Biolink's own association pattern
#    (biolink:Association, biolink:subject, biolink:object -- MIREOT'd
#    alongside the classes and properties SageBrain already reuses; see
#    scripts/import.sh) rather than inventing a bespoke reification class. The
#    project's own stated goal is that "a SageBrain graph is Biolink data...
#    with no mapping step" for the classes it reuses; associations get the
#    same treatment. Biolink has no generic numeric weight/score slot on
#    Association (checked against the v4.4.4 source rather than assumed), so
#    sagebrain:weight is minted here, the same way used_to_treat narrows
#    biolink:treats: Biolink supplies the reification structure, SageBrain
#    supplies the one slot Biolink does not have.
#
#    One class per plain property rather than per (source, target) pair --
#    de_associated_with's two pairs get two association classes instead of one
#    with an owl:onProperty/owl:allValuesFrom scoped by an sh:or, which would
#    recreate exactly the kind of per-property overloading this model avoids
#    elsewhere. subject/object typing is stated once per class as an OWL
#    restriction, so it does not depend only on the shapes graph.
#
#    The plain properties above are NOT removed: an assertion of e.g.
#    expressed_in with no known weight is still meaningful, and forcing every
#    such statement through an association node would discard information
#    (that a weight was never measured) rather than represent it. The
#    association is how you state the plain property WITH its weight; use
#    both only when they are not asserting the same weighted fact twice.
#################################################################

sagebrain:weight
    a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    rdfs:comment "The numeric weight of a differential-expression or quantitative association -- an expression level, a differential-expression score, or an association strength, depending on which Association subclass it appears on." ;
    rdfs:domain biolink:Association ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf biolink:association_slot ;
    owl:versionInfo "v0.3" .

sagebrain:GeneExpressionAssociation
    a owl:Class ;
    rdfs:subClassOf biolink:Association ,
        [ a owl:Restriction ; owl:onProperty biolink:subject ; owl:allValuesFrom biolink:Gene ] ,
        [ a owl:Restriction ; owl:onProperty biolink:object ; owl:allValuesFrom biolink:MaterialSample ] ;
    rdfs:label "Gene Expression Association" ;
    rdfs:comment "Reifies sagebrain:expressed_in with its weight. subject: a Gene. object: a Sample. weight: expression level relative to differential-expression results." ;
    owl:versionInfo "v0.3" .

sagebrain:SampleDEAssociation
    a owl:Class ;
    rdfs:subClassOf biolink:Association ,
        [ a owl:Restriction ; owl:onProperty biolink:subject ; owl:allValuesFrom biolink:MaterialSample ] ,
        [ a owl:Restriction ; owl:onProperty biolink:object ; owl:allValuesFrom biolink:Pathway ] ;
    rdfs:label "Sample Differential-Expression Association" ;
    rdfs:comment "Reifies the Sample -> Pathway pairing of sagebrain:de_associated_with with its weight. subject: a Sample. object: a Pathway. weight: the differential-expression score." ;
    owl:versionInfo "v0.3" .

sagebrain:PathwayDEAssociation
    a owl:Class ;
    rdfs:subClassOf biolink:Association ,
        [ a owl:Restriction ; owl:onProperty biolink:subject ; owl:allValuesFrom biolink:Pathway ] ,
        [ a owl:Restriction ; owl:onProperty biolink:object ; owl:allValuesFrom sagebrain:DiseaseStage ] ;
    rdfs:label "Pathway Differential-Expression Association" ;
    rdfs:comment "Reifies the Pathway -> DiseaseStage pairing of sagebrain:de_associated_with with its weight. subject: a Pathway. object: a DiseaseStage. weight: the differential-expression score." ;
    owl:versionInfo "v0.3" .

sagebrain:PathwayDiseaseAssociation
    a owl:Class ;
    rdfs:subClassOf biolink:Association ,
        [ a owl:Restriction ; owl:onProperty biolink:subject ; owl:allValuesFrom biolink:Pathway ] ,
        [ a owl:Restriction ; owl:onProperty biolink:object ; owl:allValuesFrom biolink:Disease ] ;
    rdfs:label "Pathway Disease Association" ;
    rdfs:comment "Reifies sagebrain:associated_with with its weight. subject: a Pathway. object: a DiseaseLabel. weight: strength of the pathway-disease association." ;
    owl:versionInfo "v0.3" .
