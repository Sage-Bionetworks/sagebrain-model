@prefix gov:       <https://sagebionetworks.org/governance/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix shape:     <https://w3id.org/synapse/sagebrain/shapes#> .
@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .

#################################################################
#    Shapes graph
#################################################################

<https://w3id.org/synapse/sagebrain/governance/shapes>
    a owl:Ontology ;
    dcterms:title "SageBrain pipeline provenance -- SHACL shapes" ;
    rdfs:comment """Constraints for ontology/governance/pipeline_provenance.ttl. Kept in its
own file, separate from sagebrain-shapes.ttl, mirroring the ontology/main vs
ontology/governance split those two directories already establish: this
layer is optional and only loaded/checked under `make WITH_GOVERNANCE=1`
(see tests/validate.py), the same opt-in boundary as the module it
constrains.

Two shapes:

  shape:UsageShape -- a prov:Usage is either a reference to a gov:SynapseEntity
    (prov:entity) or an external tool/resource reference (gov:url + rdfs:label),
    never both, never neither -- sh:xone between the two branches. gov:wasExecuted
    is required either way: it is what distinguishes "this was the tool that ran"
    from "this was data the tool consumed," independent of which branch the Usage
    is on.

  shape:ActivityShape -- a prov:Activity needs exactly one prov:generated output
    (a gov:SynapseEntity) and at least one prov:qualifiedUsage input, each
    conforming to shape:UsageShape.""" ;
    owl:imports <https://w3id.org/synapse/sagebrain/governance/pipeline_provenance> ;
    owl:versionInfo "v0.1" ;
    dcterms:created "2026-09-14"^^xsd:date .


#################################################################
#    Usage / Activity shapes
#################################################################

shape:UsageShape
    a sh:NodeShape ;
    sh:targetClass prov:Usage ;
    rdfs:label "Usage shape" ;
    rdfs:comment "A prov:Usage is either a gov:SynapseEntity reference or an external tool/resource reference, never both, never neither." ;

    sh:xone (
        [
            sh:property [
                sh:path prov:entity ;
                sh:name "entity" ;
                sh:class gov:SynapseEntity ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ; sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path gov:url ;
                sh:name "url" ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path rdfs:label ;
                sh:name "label" ;
                sh:maxCount 0 ;
            ] ;
        ]
        [
            sh:property [
                sh:path gov:url ;
                sh:name "url" ;
                sh:datatype xsd:string ;
                sh:minCount 1 ; sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path rdfs:label ;
                sh:name "label" ;
                sh:datatype xsd:string ;
                sh:minCount 1 ; sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path prov:entity ;
                sh:name "entity" ;
                sh:maxCount 0 ;
            ] ;
        ]
    ) ;
    sh:message "A Usage must be either a gov:SynapseEntity (prov:entity) or an external tool reference (gov:url + rdfs:label), not both and not neither." ;

    sh:property [
        sh:path gov:wasExecuted ;
        sh:name "was executed" ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A Usage needs exactly one xsd:boolean gov:wasExecuted, whichever branch it's on." ;
    ] ;
    sh:property [
        sh:path gov:entityVersionNumber ;
        sh:name "entity version number" ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "A Usage's entityVersionNumber, when present, must be a single xsd:integer." ;
    ] .

shape:ActivityShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    rdfs:label "Activity shape" ;
    rdfs:comment "One pipeline run: exactly one output (prov:generated, a gov:SynapseEntity), at least one input (prov:qualifiedUsage)." ;

    sh:property [
        sh:path prov:generated ;
        sh:name "generated" ;
        sh:class gov:SynapseEntity ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An Activity needs exactly one prov:generated output, a SynapseEntity." ;
    ] ;
    sh:property [
        sh:path prov:qualifiedUsage ;
        sh:name "qualified usage" ;
        sh:node shape:UsageShape ;
        sh:minCount 1 ;
        sh:message "An Activity needs at least one prov:qualifiedUsage input, each conforming to shape:UsageShape." ;
    ] .
