<https://w3id.org/biolink/vocab/association_slot> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/biolink/vocab/Activity
<https://w3id.org/biolink/vocab/Activity> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/biolink/vocab/NamedThing> ;
                                          rdfs:label "activity" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
                                          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.bioontology.org/ontology/STY/T052> ,
                                                                                           <http://purl.obolibrary.org/obo/NCIT_C43431> ,
                                                                                           <http://www.w3.org/ns/prov#Activity> ;
                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                          <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T056> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T057> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T058> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T062> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T064> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T065> ,
                                                                                            <http://purl.bioontology.org/ontology/STY/T066> .


###  https://w3id.org/biolink/vocab/Association
<https://w3id.org/biolink/vocab/Association> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/biolink/vocab/Entity> ;
                                             rdfs:label "association" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A typed association between two entities, supported by evidence" ;
                                             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.org/oban/association> ,
                                                                                              rdf:Statement ,
                                                                                              owl:Axiom ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                             <http://www.w3.org/2004/02/skos/core#note> "This is roughly the model used by biolink and ontobio at the moment" .


###  https://w3id.org/biolink/vocab/BiologicalEntity
<https://w3id.org/biolink/vocab/BiologicalEntity> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/biolink/vocab/NamedThing> ;
                                                  rdfs:label "biological entity" ;
                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "bioentity" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A heterogeneous substance that contains genomic material or is the product of a biological process." ;
                                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                                  <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T050> ,
                                                                                                    <http://purl.bioontology.org/ontology/STY/T129> ,
                                                                                                    <http://semanticscience.org/resource/SIO_010046> ,
                                                                                                    <https://www.wikidata.org/entity/Q28845870> .


###  https://w3id.org/biolink/vocab/BiologicalProcess
<https://w3id.org/biolink/vocab/BiologicalProcess> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/biolink/vocab/BiologicalProcessOrActivity> ;
                                                   rdfs:label "biological process" ;
                                                   <http://www.w3.org/2004/02/skos/core#broadMatch> <https://www.wikidata.org/entity/P682> ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "One or more causally connected executions of molecular functions" ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/GO_0008150> ,
                                                                                                    <http://semanticscience.org/resource/SIO_000006> ,
                                                                                                    <https://www.wikidata.org/entity/Q2996394> ;
                                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> .


###  https://w3id.org/biolink/vocab/BiologicalProcessOrActivity
<https://w3id.org/biolink/vocab/BiologicalProcessOrActivity> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/biolink/vocab/BiologicalEntity> ;
                                                             rdfs:label "biological process or activity" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "Either an individual molecular activity, or a collection of causally connected molecular activities in a biological system." ;
                                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> .


###  https://w3id.org/biolink/vocab/ChemicalEntity
<https://w3id.org/biolink/vocab/ChemicalEntity> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/biolink/vocab/NamedThing> ;
                                                rdfs:label "chemical entity" ;
                                                <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.bioontology.org/ontology/STY/T167> ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A chemical entity is a physical entity that pertains to chemistry or biochemistry." ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.bioontology.org/ontology/STY/T103> ,
                                                                                                 <http://purl.obolibrary.org/obo/CHEBI_24431> ,
                                                                                                 <http://semanticscience.org/resource/SIO_010004> ,
                                                                                                 <https://www.wikidata.org/entity/Q79529> ;
                                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                                <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T123> ,
                                                                                                  <http://purl.bioontology.org/ontology/STY/T131> ,
                                                                                                  <https://www.wikidata.org/entity/Q43460564> .


###  https://w3id.org/biolink/vocab/ChemicalMixture
<https://w3id.org/biolink/vocab/ChemicalMixture> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/biolink/vocab/ChemicalEntity> ;
                                                 rdfs:label "chemical mixture" ;
                                                 <http://www.w3.org/2004/02/skos/core#closeMatch> <https://datacommons.org/browser/ChemicalCompound> ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A chemical mixture is a chemical entity composed of two or more molecular entities." ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                                 <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/NCIT_C20401> ,
                                                                                                   <http://snomed.info/id/49616005> .


###  https://w3id.org/biolink/vocab/ClinicalTrial
<https://w3id.org/biolink/vocab/ClinicalTrial> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/biolink/vocab/Study> ;
                                               rdfs:label "clinical trial" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A clinical trial is a research study that prospectively assigns human participants or groups of humans to one or more health-related interventions to evaluate the effects on health outcomes." ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/NCIT_C71104> ,
                                                                                                <http://semanticscience.org/resource/SIO_001000> ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> .


###  https://w3id.org/biolink/vocab/Disease
<https://w3id.org/biolink/vocab/Disease> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature> ;
                                         rdfs:label "disease" ;
                                         <http://www.w3.org/2004/02/skos/core#altLabel> "condition" ,
                                                                                        "disorder" ,
                                                                                        "medical condition" ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "A disease is a disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism. A disorder of structure or function, especially one that produces specific signs, phenotypes or symptoms or that affects a specific location and is not simply a direct result of physical injury." ;
                                         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.bioontology.org/ontology/STY/T047> ,
                                                                                          <http://purl.obolibrary.org/obo/DOID_4> ,
                                                                                          <http://purl.obolibrary.org/obo/MONDO_0000001> ,
                                                                                          <http://purl.obolibrary.org/obo/NCIT_C2991> ,
                                                                                          <http://semanticscience.org/resource/SIO_010299> ,
                                                                                          <https://datacommons.org/browser/Disease> ,
                                                                                          <https://lhncbc.nlm.nih.gov/semanticnetwork/download/sg_archive/SemGroups-v04.txtDISO> ,
                                                                                          <https://www.wikidata.org/entity/Q12136> ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                         <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.bioontology.org/ontology/STY/T019> ,
                                                                                           <http://purl.bioontology.org/ontology/STY/T020> ,
                                                                                           <http://purl.bioontology.org/ontology/STY/T048> ,
                                                                                           <http://purl.bioontology.org/ontology/STY/T049> ,
                                                                                           <http://purl.bioontology.org/ontology/STY/T191> ,
                                                                                           <http://purl.obolibrary.org/obo/MONDO_0042489> .


###  https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature
<https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/biolink/vocab/BiologicalEntity> ;
                                                            rdfs:label "disease or phenotypic feature" ;
                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "phenome" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A disease or an individual phenotypic feature, grouped as a single class to accommodate source vocabularies and assertions that do not distinguish the two. Prefer the more specific subclasses disease or phenotypic feature when the distinction is known." ;
                                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/biolink/vocab/> ;
                                                            <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.bioontology.org/ontology/STY/T033> .


###  https://w3id.org/biolink/vocab/Drug
<https://w3id.org/biolink/vocab/Drug> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/biolink/vocab/MolecularMixture> ;
                                      rdfs:label "drug" ;
                                      <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.bioontology.org/ontology/STY/T121> ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A substance intended for use in the diagnosis, cure, mitigation, treatment, or prevention of disease" ;
                                      <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.bioontology.org/ontology/STY/T200> ,
                                                                                       <http://purl.obolibrary.org/obo/CHEBI_23888> ,
                                                                                       <https://datacommons.org/browser/Drug> ,
                                                                                       <https://www.wikidata.org/entity/Q12140> ;
