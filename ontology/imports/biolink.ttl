@base <https://w3id.org/synapse/sagebrain/imports/biolink> .

<https://w3id.org/synapse/sagebrain/imports/biolink> rdf:type owl:Ontology ;
                                                      owl:versionIRI <https://w3id.org/synapse/sagebrain/imports/biolink/4.4.4> ;
                                                      <http://purl.org/dc/terms/description> "MIREOT extract of the Biolink Model terms SageBrain reuses (gene, pathway, disease, drug, clinical trial, material sample, participates in, treats, association, subject, object) and their ancestors. Generated by scripts/import.sh from Biolink v4.4.4; do not edit by hand." ;
                                                      <http://purl.org/dc/terms/source> <https://raw.githubusercontent.com/biolink/biolink-model/v4.4.4/project/owl/biolink_model.owl.ttl> ;
                                                      <http://purl.org/dc/terms/title> "Biolink Model -- SageBrain import module" .

