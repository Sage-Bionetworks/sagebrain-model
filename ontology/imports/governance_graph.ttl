@prefix gov: <https://sagebionetworks.org/governance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/synapse/sagebrain/imports/governance_graph> .

# Hand-curated, single-class extract of gov:SynapseEntity from
# mc2-center/governanceDUO's shapes/governance_graph.owl.ttl, pinned at
# governanceDUO commit abf8c9f (branch kg-conversion). Reused so that a
# SageBrain-graph reference to a source file/entity uses the exact same class
# IRI governanceDUO's own governance graph does -- see sagebrain:derived_from
# in ontology/main/sagebrain.ttl and plans/gene_expression_de_metadata.md.
#
# NOT run through scripts/import.sh, unlike biolink.ttl/duo.ttl/prov.ttl:
# governance_graph.owl.ttl is a small (~350-line), hand-authored TBox in an
# actively developed sibling repo on the same machine -- not a network-
# fetchable, independently versioned release with a stable URL to pin ROBOT
# against. It also declares dozens of unrelated governance/access-control
# classes (AccessGrant, DataAccessSubmission, ResearchProject, Principal,
# ...) that would bury this model's rendered graph the same way importing
# all of Biolink would (see biolink.ttl's own MIREOT rationale in
# scripts/import.sh) -- so, same MIREOT principle, different mechanism: only
# the one term actually used is copied, by hand. gov:SynapseEntity has no
# rdfs:subClassOf parent in the source file, so there is no ancestor chain to
# additionally preserve; this single declaration is the complete extract.
#
# Committed, and never rebuilt by this repo's build (same contract as the
# ROBOT-generated modules). To re-sync: re-copy gov:SynapseEntity's
# declaration from governanceDUO's shapes/governance_graph.owl.ttl by hand,
# update the pinned commit hash above, and commit the diff -- there is no
# automated regeneration path for this module.

<https://w3id.org/synapse/sagebrain/imports/governance_graph>
    a owl:Ontology ;
    <http://purl.org/dc/terms/title> "Sage governance graph -- SageBrain import module" ;
    <http://purl.org/dc/terms/description> "Hand-curated extract of the one governanceDUO governance-graph term SageBrain reuses (gov:SynapseEntity). Pinned at mc2-center/governanceDUO commit abf8c9f (branch kg-conversion); do not edit the copied declaration below without updating that pin." ;
    <http://purl.org/dc/terms/source> <https://github.com/mc2-center/governanceDUO/blob/abf8c9f/shapes/governance_graph.owl.ttl> .

gov:SynapseEntity a owl:Class ;
    rdfs:comment "Mirrors governanceduo:SynapseEntity (governance_graph.yaml), re-declared here under gov:'s own namespace." .
