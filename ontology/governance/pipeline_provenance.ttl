@prefix gov:   <https://sagebionetworks.org/governance/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@base <https://w3id.org/synapse/sagebrain/governance/pipeline_provenance> .

# The reprocessing-pipeline provenance layer (raw input -> processed output ->
# post-processing output, e.g. DE analysis), additive to sagebrain:derived_from
# -- see its own comment in ontology/main/sagebrain.ttl and
# plans/pipeline_provenance_layer.md for why this is a separate, optional
# layer rather than a change to that property.
#
# Reuses prov:Activity/prov:Usage/prov:generated/prov:qualifiedUsage/prov:entity
# directly by IRI (already vendored at ontology/imports/prov.ttl, gated behind
# `make WITH_GOVERNANCE=1` same as this module) -- one prov:Activity per
# pipeline run, prov:generated its output, prov:qualifiedUsage its inputs
# (including the tool/workflow itself, as a Usage marked gov:wasExecuted true).
# No new classes: governanceDUO's own provenance.yaml types Activity/Usage
# individuals directly (no subclass), so this module follows the same pattern.
#
# The three properties below are hand-curated, not scripts/import.sh-generated
# (same contract as ontology/imports/governance_graph.ttl): mc2-center/
# governanceDUO's linkml/provenance.yaml (pinned at commit abf8c9f, branch
# kg-conversion -- same commit governance_graph.ttl already pins; re-check at
# implementation/re-sync time) already commits to gov:wasExecuted, gov:url and
# gov:entityVersionNumber via slot_uri, but governanceDUO has not itself
# rendered them as OWL anywhere (only governance_graph.owl.ttl and
# governance_duo.owl.ttl exist under its shapes/, no provenance.owl.ttl
# counterpart) -- so this is the first OWL declaration of these two already-
# pinned IRIs, not a fresh invention. To re-sync: re-check these three slots
# in governanceDUO's linkml/provenance.yaml against the declarations below and
# update the pinned commit if their definitions changed.
#
# Deliberately does NOT reuse governanceDUO's own Usage.name (its
# governanceduo:name display-name slot): that would pull in a second cross-
# repo namespace for one cosmetic field. rdfs:label plays that role here
# instead -- already used throughout sagebrain.ttl, no import needed.

<https://w3id.org/synapse/sagebrain/governance/pipeline_provenance>
    a owl:Ontology ;
    <http://purl.org/dc/terms/title> "SageBrain pipeline provenance -- gov: Usage extensions" ;
    <http://purl.org/dc/terms/description> "Hand-curated gov: properties (wasExecuted, url, entityVersionNumber) completing prov:Usage for Synapse-native computational provenance, pinned to mc2-center/governanceDUO's linkml/provenance.yaml at commit abf8c9f (branch kg-conversion)." ;
    <http://purl.org/dc/terms/source> <https://github.com/mc2-center/governanceDUO/blob/abf8c9f/linkml/provenance.yaml> .

gov:wasExecuted
    a owl:DatatypeProperty ;
    rdfs:label "was executed" ;
    rdfs:comment "Distinguishes a prov:Usage that was executed (a tool, script, or workflow) from one that was merely consumed as data. Mirrors Synapse's real Used.wasExecuted verbatim (\"The enclosed entity was used and also executed in the Activity\") -- a Synapse-specific flag with no PROV-O predicate equivalent, per governanceDUO's own grounding pass." ;
    rdfs:domain prov:Usage ;
    rdfs:range xsd:boolean .

gov:url
    a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:comment "The external URL of the tool or resource a prov:Usage consumed, when that Usage is not itself a gov:SynapseEntity (e.g. a pipeline's own release page, such as an nf-core workflow version). Mirrors Synapse's real UsedURL.url." ;
    rdfs:domain prov:Usage ;
    rdfs:range xsd:string .

gov:entityVersionNumber
    a owl:DatatypeProperty ;
    rdfs:label "entity version number" ;
    rdfs:comment "The specific version of the gov:SynapseEntity a prov:Usage's prov:entity refers to. Mirrors Synapse's real UsedEntity.reference.targetVersionNumber; PROV-O has no version-scoping equivalent for entities." ;
    rdfs:domain prov:Usage ;
    rdfs:range xsd:integer .
